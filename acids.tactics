GO LOW:0
GO HIGH:0 
GO HOME:0
GO LOW:1
GO HIGH:1
GO HOME:0
IF SAFE LOW:2
  GO LOW:2
  GO HOME:0
ELSE IF SAFE LOW:-2
  GO LOW:-2
ENDIF
IF SAFE HIGH:-1
  GO HIGH:-1
ENDIF
GO HOME:0

LOOP
  IF NOT SAFE HOME:0
    BARGE
  ENDIF
  IF SAFE HOME:1 AND HOME:1 = TARGET
    STEAL HOME:1
    HOME
  END IF
  IF SAFE HOME:-1 AND HOME:-1 = TARGET
    STEAL HOME:-1
    HOME
  ENDIF
ENDLOOP